{
  "name": "trailthread",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:reset": "npm run build:cities",
    "build:cities": "python scripts/build-europe-cities.py --geonames && python scripts/prune-park-places-from-cities.py && python scripts/build-cities-db.py",
    "build:countries-geo": "python scripts/build-europe-countries-geo.py",
    "build:db": "python scripts/build-cities-db.py",
    "build:ferry-routes": "python scripts/build-ferry-routes.py",
    "build:transit-routes": "python scripts/build-transit-routes.py",
    "build:hikes": "python scripts/build-hikes-db.py --curated-only",
    "build:hikes:montenegro": "python scripts/build-hikes-db.py --montenegro --curated-only",
    "build:hikes:curated": "python scripts/build-hikes-db.py --curated-only",
    "build:hikes:known": "python scripts/build-hikes-db.py --discover --limit 200 --min-discover-km 25 --sleep 0.85",
    "build:hikes:full": "python scripts/build-hikes-db.py --discover --limit 200 --min-discover-km 25 --sleep 0.85",
    "build:hikes:expand": "python scripts/build-hikes-db.py --discover --limit 200 --min-discover-km 25 --sleep 0.7",
    "seed:oceania": "python3 scripts/seed-oceania.py",
    "enrich:cities": "python scripts/enrich-cities-db.py --photos fast --workers 12 --tier all --progress",
    "enrich:cities:full": "python scripts/enrich-cities-db.py --photos full --workers 10 --tier all --progress",
    "enrich:cities:batch": "python scripts/enrich-cities-db.py --photos fast --workers 12 --limit 800 --tier all --progress",
    "enrich:hikes": "python scripts/enrich-hikes-db.py --workers 6 --progress",
    "enrich:hikes:parallel": "python scripts/enrich-hikes-db.py --workers 6 --progress",
    "enrich:europe": "python scripts/run-europe-enrichment.py --workers 12 --hike-workers 6 --photos fast --city-batch 800 --sleep 3",
    "enrich:repair": "python scripts/repair-enriched-cards.py",
    "repair:city-photos": "python scripts/repair-city-photos.py --workers 6 --progress",
    "repair:city-photos:validate": "python scripts/repair-city-photos.py --validate-only --workers 8 --progress",
    "repair:city-photos:empty": "python scripts/repair-city-photos.py --empty-photos-only --workers 2 --progress",
    "repair:city-highlights": "python scripts/repair-city-highlights.py",
    "repair:city-highlights:refetch": "python scripts/repair-city-highlights.py --refetch-broken",
    "repair:city-copy": "python scripts/fix-broken-generals.py",
    "migrate:city-highlights": "python scripts/migrate-city-highlights-col.py",
    "enrich:major-cards": "python scripts/enrich-major-cards.py --limit 40",
    "build:parks": "python scripts/build-parks-db.py",
    "build:poi": "python scripts/build-poi-db.py",
    "build:catalogs": "python scripts/build-parks-db.py && python scripts/build-poi-db.py && python scripts/build-hikes-db.py --curated-only && npm run seed:oceania",
    "consolidate:catalogs": "python scripts/consolidate-catalog-dbs.py",
    "catalog:stats": "python scripts/print-catalog-stats.py",
    "classify:places": "python scripts/classify-places.py --apply --stats",
    "classify:places:preview": "python scripts/classify-places.py --stats",
    "refresh:activities": "python scripts/apply-place-activities.py --apply",
    "refresh:activities:force": "python scripts/apply-place-activities.py --apply --force",
    "refresh:activities:preview": "python scripts/apply-place-activities.py",
    "prune:park-cities": "python scripts/prune-park-places-from-cities.py",
    "enrich:poi": "python scripts/enrich-poi-db.py --sleep-min 2.5 --sleep-max 5",
    "enrich:poi:all": "python scripts/enrich-poi-db.py --force --sleep-min 2.5 --sleep-max 5",
    "enrich:parks": "python scripts/enrich-parks-db.py --country Montenegro --tier all --force",
    "enrich:parks:by-country": "python scripts/enrich-parks-db.py --by-country --start-country Montenegro --tier all",
    "enrich:parks:montenegro": "python scripts/enrich-parks-db.py --country Montenegro --tier all --force",
    "enrich:parks:all": "python scripts/enrich-parks-db.py --by-country --tier all"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "leaflet": "^1.9.4",
    "marked": "^13.0.2"
  },
  "devDependencies": {
    "sql.js": "^1.12.0",
    "vite": "^5.4.10"
  }
}
