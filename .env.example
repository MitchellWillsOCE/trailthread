# Upstash Redis — required on Vercel for cross-device journey share codes.
# Copy to `.env` for local dev only (never commit `.env`).
#
# Vercel: Project → Settings → Environment Variables, or connect
# Storage → Upstash Redis (often auto-fills UPSTASH_* names below).
#
# Use the READ/WRITE REST token (not read-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Same values under Vercel KV-style names also work:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
