node_modules/
dist/
scripts/cache/
scripts/__pycache__/
**/__pycache__/

# SQLite runtime files (the .db catalogs themselves are committed; only the
# transient WAL/SHM sidecars should never be tracked)
*.db-wal
*.db-shm

# Vercel local CLI state
.vercel/

# Logs and temporary debug session artifacts
logs/
*.log
debug-*.log
.tmp-*

# Backups & build-progress checkpoints
*.bak
scripts/data/_seed-correction-progress.json

# Editor / IDE metadata
.cursor/
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db
.vercel
